# Gemini API key configuration for RAMMA service
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# DATABASE_URL CONFIGURATION
# ==============================================================================

# Mode 1: Local Development with SQLite (Default)
DATABASE_URL=sqlite:///./ramma_local.db

# Mode 2: PostgreSQL (used automatically in Docker Compose or local Postgres)
# DATABASE_URL=postgresql://ramma_user:ramma_password@localhost:5432/rammadb

POSTGRES_USER=ramma_user
POSTGRES_PASSWORD=ramma_password
